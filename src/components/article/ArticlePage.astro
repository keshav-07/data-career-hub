---
import { render } from "astro:content";
import { getHub, type ItemOf } from "../../utils/content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import NextStep from "../content/NextStep.astro";
import Callout from "../content/Callout.astro";
import { breadcrumbsFor } from "../../utils/breadcrumbs";
import { relatedGroups } from "../../utils/related";
import { courseNav, sectionNav } from "../../utils/navigation";

interface Props {
  item: ItemOf<"articles">;
}
const { item } = Astro.props;
const d = item.entry.data;
const { Content, headings } = await render(item.entry);
const crumbs = await breadcrumbsFor(item);
const { prerequisites } = await relatedGroups(item);
const isTutorial = d.kind === "tutorial";
const isCareer = d.section === "career";
const hub = isCareer ? undefined : await getHub(d.technology[0]);
const nav = isCareer ? await sectionNav("career", item.url) : await courseNav(item);
---

<ArticleLayout
  nav={nav}
  item={item}
  crumbs={crumbs}
  headings={headings}
  eyebrow={
    isCareer
      ? "Career guide"
      : hub
        ? `${hub.entry.data.shortName} course${isTutorial ? " · Tutorial" : ""}`
        : "Guide"
  }
  deck={item.description}
  meta={[d.difficulty, d.pillar && "Pillar guide"]}
>
  {prerequisites.length > 0 && (
    <Callout tone="info" title="Before you start">
      <ul style="margin:0;padding-left:1.2rem">
        {prerequisites.map((p) => (
          <li>
            <a href={p.url}>{p.title}</a>
          </li>
        ))}
      </ul>
    </Callout>
  )}
  {isTutorial && d.learningObjectives.length > 0 && (
    <section aria-labelledby="goals-h" style="margin-top: var(--sp-6)">
      <h2 id="goals-h" style="font-size: var(--fs-xl); border:0; padding:0">
        What you will learn
      </h2>
      <ul>
        {d.learningObjectives.map((o) => (
          <li>{o}</li>
        ))}
      </ul>
    </section>
  )}
  <Content components={{ Callout }} />

  <Fragment slot="footer">
    {d.sources.length > 0 && (
      <section class="related-block" aria-labelledby="sources-h">
        <h2 id="sources-h">Sources and further reading</h2>
        <ul class="link-list">
          {d.sources.map((s) => (
            <li>
              <a class="row" href={s.url} rel="noopener">
                <span class="row__title">{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    {isCareer && (
      <NextStep
        title="Keep building toward the job"
        text="Pick a plan, build a project you can explain, and practise the interview questions that match it."
        href="/roadmaps/"
        label="Browse roadmaps and plans"
      />
    )}
    {hub && (
      <NextStep
        title={`Back to the ${hub.entry.data.shortName} course`}
        text="See every lesson, your progress, projects and the cheat sheet for this course."
        href={hub.url}
        label={`Open the ${hub.entry.data.shortName} course`}
      />
    )}
  </Fragment>
</ArticleLayout>
