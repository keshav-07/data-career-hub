---
/**
 * Course "Practice" tab: every problem grouped by topic, then by pattern subfolder, each with a done tick (shared
 * with the interview pages via scripts/progress.ts), DataDank's own solution where written, and one external
 * practice link. Groups follow the planner order (curriculum.json).
 */
import type { PracticeGroup } from "../../utils/curriculum";

interface Props {
  groups: PracticeGroup[];
  course: string;
}
const { groups, course } = Astro.props;
const count = (g: PracticeGroup) => g.sections.reduce((n, s) => n + s.rows.length, 0);
const total = groups.reduce((n, g) => n + count(g), 0);
const solved = groups.reduce(
  (n, g) => n + g.sections.reduce((m, s) => m + s.rows.filter((r) => r.url).length, 0),
  0,
);
---

<div class="practice" data-practice>
  <p class="practice__intro">
    {total} problems in {groups.length} {groups.length === 1 ? "topic" : "topics"}, from basic to
    advanced.
    {solved < total && (
      <>
        {" "}
        {solved} have a full DataDank solution; the rest link to the platform while theirs is
        written.
      </>
    )}
    <span class="js-only">
      {" "}
      <strong data-practice-done>0</strong> of {total} done.
    </span>
  </p>
  {groups.map((g, gi) => (
    <details class="practice-group" open={gi < 2} data-practice-group>
      <summary class="practice-group__head">
        <span class="practice-group__name">{g.name}</span>
        <span class="practice-group__count">
          <span class="js-only">
            <span data-group-done>0</span>/
          </span>
          {count(g)}
        </span>
      </summary>
      {g.lesson && (
        <p class="practice-group__lesson">
          Pattern lesson: <a href={g.lesson.url}>{g.lesson.title}</a>
        </p>
      )}
      {g.sections.map((sec) => (
        <section class="practice-section">
          {sec.name && g.sections.length > 1 && (
            <h3 class="practice-section__name">
              {sec.name}
              <span class="practice-section__count">{sec.rows.length}</span>
            </h3>
          )}
          <ol class="practice-rows" role="list">
            {sec.rows.map((r) => (
              <li class="practice-row">
                <input
                  type="checkbox"
                  class="practice-row__check js-only"
                  data-done-url={r.doneUrl}
                  data-kind="question"
                  data-course={course}
                  data-title={r.title}
                  aria-label={`Mark "${r.title}" as done`}
                />
                {r.url ? (
                  <a class="practice-row__title" href={r.url} data-progress-url={r.url}>
                    {r.title}
                  </a>
                ) : (
                  <span class="practice-row__title practice-row__title--plain">
                    {r.title}
                    <span class="practice-row__soon">Solution coming</span>
                  </span>
                )}
                <span class={`diff diff--${r.difficulty.toLowerCase()}`}>{r.difficulty}</span>
                {r.practice ? (
                  <a
                    class="practice-row__ext"
                    href={r.practice.url}
                    target="_blank"
                    rel="noopener external"
                    title={`${r.practice.platform}${r.practice.number ? ` ${r.practice.number}` : ""}: ${r.practice.title}`}
                  >
                    {r.practice.platform}
                    <span aria-hidden="true"> ↗</span>
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                ) : (
                  <span class="practice-row__ext practice-row__ext--none">DataDank only</span>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </details>
  ))}
  <p class="muted js-only" style="margin-top: var(--sp-3); font-size: var(--fs-sm)">
    Ticks are saved in this browser only and match the ticks on the interview pages.
  </p>
</div>

<script>
  // Done counts per topic and overall, kept in step with the ticks (scripts/progress.ts saves them).
  const root = document.querySelector<HTMLElement>("[data-practice]");
  if (root) {
    const update = () => {
      let all = 0;
      root.querySelectorAll<HTMLElement>("[data-practice-group]").forEach((g) => {
        const n = g.querySelectorAll("input[data-done-url]:checked").length;
        all += n;
        const out = g.querySelector("[data-group-done]");
        if (out) out.textContent = String(n);
      });
      const done = root.querySelector("[data-practice-done]");
      if (done) done.textContent = String(all);
    };
    root.addEventListener("change", () => setTimeout(update));
    window.addEventListener("load", update);
    update();
  }
</script>
