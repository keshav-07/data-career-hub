---
import type { Item } from "../../utils/content";
interface Props {
  previous?: Item;
  next?: Item;
}
const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav class="prev-next" aria-label="Previous and next">
    {previous ? (
      <a href={previous.url} rel="prev">
        <small>Previous</small>
        {previous.title}
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a href={next.url} rel="next" class="is-next">
        <small>Next</small>
        {next.title}
      </a>
    )}
  </nav>
)}
