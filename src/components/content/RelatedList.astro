---
import type { RelatedGroup } from "../../utils/related";
import Tile from "./Tile.astro";
interface Props {
  groups: RelatedGroup[];
}
const { groups } = Astro.props;
---

{groups.length > 0 && (
  <section class="related-block" aria-labelledby="related-heading" data-pagefind-ignore>
    <h2 id="related-heading">Keep learning</h2>
    {groups.map((g) => (
      <div>
        <h3 class="group-title">{g.label}</h3>
        <ul class="tile-grid" role="list">
          {g.items.map((i) => (
            <li>
              <Tile href={i.url} eyebrow={i.typeLabel} title={i.title} level={i.difficulty} />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}
