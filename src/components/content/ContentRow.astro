---
import type { Item } from "../../utils/content";
interface Props {
  item: Item;
  showType?: boolean;
}
const { item, showType = false } = Astro.props;
const meta = [showType && item.typeLabel, item.difficulty].filter(Boolean);
---

<a class="row" href={item.url}>
  <span class="row__title">{item.title}</span>
  <span class="row__desc">{item.description}</span>
  {meta.length > 0 && <span class="row__meta">{meta.join(" · ")}</span>}
</a>
