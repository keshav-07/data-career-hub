---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/navigation/Breadcrumb.astro";
import SideNav from "../components/navigation/SideNav.astro";
import Pager from "../components/navigation/Pager.astro";
import Toc from "../components/content/Toc.astro";
import Metadata from "../components/content/Metadata.astro";
import IndexMeta from "../components/content/IndexMeta.astro";
import Explore from "../components/content/Explore.astro";
import DoneButton from "../components/content/DoneButton.astro";
import AdSlot from "../components/content/AdSlot.astro";
import { articleSchema, breadcrumbSchema } from "../utils/seo";
import { formatMonthYear, isoDate } from "../utils/dates";
import { exploreFor } from "../utils/explore";
import type { Crumb } from "../utils/breadcrumbs";
import type { Item } from "../utils/content";
import type { SectionNav } from "../utils/navigation";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  item: Item;
  crumbs: Crumb[];
  headings?: Heading[];
  eyebrow?: string;
  deck?: string;
  /** Extra metadata items shown in the compact line (reading time and update date are added automatically). */
  meta?: (string | undefined | false)[];
  /** Wide technical content (system design, projects): code and tables may break out of the reading column. */
  wide?: boolean;
  schema?: object[];
  titleClass?: string;
  /** Left-hand section navigation with previous/next. */
  nav?: SectionNav;
}
const {
  item,
  crumbs,
  headings = [],
  eyebrow,
  deck,
  meta = [],
  wide = false,
  schema = [],
  titleClass,
  nav,
} = Astro.props;
const data = item.entry.data as {
  title: string;
  seoTitle?: string;
  seoDescription?: string;
  publishedDate: Date;
  updatedDate: Date;
  reviewedDate: Date;
  author: string;
  image?: string;
  imageAlt?: string;
  versionContext?: string;
};
const showToc = headings.filter((h) => h.depth === 2).length >= 3;
const explore = await exploreFor(item);
const kind = nav?.progressKind;
const jsonLd = [
  breadcrumbSchema(crumbs, Astro.url.pathname, Astro.site),
  articleSchema({
    headline: data.title,
    description: data.seoDescription ?? item.description,
    path: Astro.url.pathname,
    site: Astro.site,
    published: data.publishedDate,
    modified: data.updatedDate,
    author: data.author,
    image: data.image,
  }),
  ...schema,
];
const position = nav?.position
  ? `${nav.position.noun} ${nav.position.index} of ${nav.position.total}`
  : undefined;
---

<BaseLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.seoDescription ?? item.description}
  ogType="article"
  ogImage={data.image}
  ogImageAlt={data.imageAlt}
  schema={jsonLd}
  indexable
  publishedTime={isoDate(data.publishedDate)}
  modifiedTime={isoDate(data.updatedDate)}
>
  <IndexMeta type={item.typeLabel} technology={item.technology[0]} difficulty={item.difficulty} />
  <div
    hidden
    data-progress-page
    data-url={item.url}
    data-kind={kind ?? "other"}
    data-course={nav?.course}
    data-title={item.title}
  ></div>
  <div class:list={["course-shell container container--course", { "course-shell--no-nav": !nav }]}>
    {nav && (
      <aside class="course-shell__nav" data-pagefind-ignore>
        <SideNav nav={nav} variant="desktop" headings={headings} />
      </aside>
    )}
    <article class="course-shell__main">
      <header class="lesson-header">
        <div class="lesson-header__crumbs">
          {nav && (
            <button
              type="button"
              class="btn btn--secondary btn--sm show-menu"
              data-sidebar-toggle
              data-sidebar-open
              aria-controls="course-menu"
              aria-expanded="false"
            >
              ☰ Course menu
            </button>
          )}
          <Breadcrumb {crumbs} />
        </div>
        {nav && (
          <div class="lesson-header__mobile-nav" data-pagefind-ignore>
            <SideNav nav={nav} variant="mobile" />
          </div>
        )}
        {eyebrow && (
          <p class="eyebrow lesson-header__eyebrow" data-pagefind-weight="3">
            {eyebrow}
            {position && <span class="lesson-header__position"> · {position}</span>}
          </p>
        )}
        <h1 class:list={["lesson-header__title", titleClass]} data-pagefind-weight="10">
          {item.title}
        </h1>
        {deck && (
          <p class="deck" data-pagefind-weight="4">
            {deck}
          </p>
        )}
        <div class="lesson-header__meta">
          <Metadata
            items={[
              ...meta,
              `${item.minutes} min read`,
              `Updated ${formatMonthYear(data.updatedDate)}`,
            ]}
          />
        </div>
        <slot name="header-extra" />
      </header>

      {showToc && <Toc headings={headings} variant="mobile" />}
      <div class={`prose ${wide ? "prose--breakout" : ""}`}>
        <slot />
      </div>
      <slot name="after-prose" />
      <p class="author">
        By {data.author} · Last reviewed {formatMonthYear(data.reviewedDate)}
        {data.versionContext && <> · {data.versionContext}</>}
      </p>
      {kind && <DoneButton url={item.url} kind={kind} course={nav?.course} title={item.title} />}
      {nav && (
        <div data-pagefind-ignore>
          <Pager prev={nav.prev} next={nav.next} variant="full" noun={nav.position?.noun} />
        </div>
      )}
      <AdSlot placement="inline" />
      <slot name="footer" />
    </article>
    {explore.length > 0 && (
      <div class="course-shell__explore">
        <Explore groups={explore} />
      </div>
    )}
  </div>
</BaseLayout>

<script>
  // Keep the current lesson visible in a long sidebar, without hiding the course title when it already fits.
  const current = document.querySelector<HTMLElement>(".side-nav--desktop [aria-current='page']");
  const box = current?.closest<HTMLElement>(".course-shell__nav");
  if (current && box) {
    const offset = current.getBoundingClientRect().top - box.getBoundingClientRect().top;
    if (offset > box.clientHeight * 0.7) box.scrollTop = offset - box.clientHeight / 3;
  }
</script>
