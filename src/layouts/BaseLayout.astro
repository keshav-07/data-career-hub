---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileMenu from "../components/navigation/MobileMenu.astro";
import SearchDialog from "../components/search/SearchDialog.astro";
import { SITE } from "../data/site";
import { absoluteUrl, pageTitle, websiteSchema } from "../utils/seo";

interface Props {
  title: string;
  description: string;
  /** Overrides the computed <title> (SEO title). */
  seoTitle?: string;
  noindex?: boolean;
  /** Open Graph type */
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  schema?: object[];
  /** Include this page's <main> in the static search index. */
  indexable?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  seoTitle,
  noindex = false,
  ogType = "website",
  ogImage = SITE.defaultOgImage,
  ogImageAlt = `${SITE.name}: ${SITE.tagline}`,
  schema = [],
  indexable = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = pageTitle(seoTitle ?? title);
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const ogImageUrl = absoluteUrl(ogImage, Astro.site);
const isHome = Astro.url.pathname === "/";
const jsonLd = [...(isHome ? [websiteSchema(Astro.site)] : []), ...schema];
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const adsClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <!-- Brand icons from the supplied DataDank app icon; ?v= busts browser favicon caches after the rebrand. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#f8f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    {adsClient && <meta name="dch-ads-client" content={adsClient} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={seoTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme bootstrap: tiny, deterministic, no network. Prevents a light/dark flash. -->
    <script is:inline>
      (function () {
        const d = document.documentElement;
        d.classList.add("js");
        try {
          const t = localStorage.getItem("dch-theme");
          if (localStorage.getItem("dch-sidebar") === "collapsed")
            d.setAttribute("data-sidebar", "collapsed");
          if (t === "light" || t === "dark") d.setAttribute("data-theme", t);
        } catch {
          /* storage unavailable: follow the system theme */
        }
      })();
    </script>
    {jsonLd.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <Header />
    <MobileMenu />
    <main id="main" tabindex="-1" data-pagefind-body={indexable ? "" : undefined}>
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <script>
      import "../scripts/site";
    </script>
    {analyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
