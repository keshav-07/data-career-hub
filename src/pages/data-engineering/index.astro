---
import ContentLayout from "../../layouts/ContentLayout.astro";
import Button from "../../components/content/Button.astro";
import { getItems } from "../../utils/content";
import { TECH_GROUP_LABELS } from "../../data/site";
import { HOME } from "../../utils/breadcrumbs";

const hubs = (await getItems("technologies")).sort(
  (a, b) => a.entry.data.order - b.entry.data.order,
);
const groups = Object.keys(TECH_GROUP_LABELS)
  .map((g) => ({
    label: TECH_GROUP_LABELS[g],
    items: hubs.filter((h) => h.entry.data.group === g),
  }))
  .filter((g) => g.items.length);
const pillars = (await getItems("articles")).filter((a) => a.entry.data.pillar);
---

<ContentLayout
  title="Learn Data Engineering"
  description="Learn Data Engineering technology by technology: SQL, Python, Spark, warehousing, streaming and orchestration, with a roadmap to put them in order."
  crumbs={[HOME, { label: "Learn" }]}
  eyebrow="Learn"
  deck="Start with the roadmap, then go deep on one technology at a time."
  indexable
>
  <section class="section section--tight">
    <div class="cluster">
      <Button href="/data-engineering/roadmap/">Data Engineer roadmap</Button>
      <Button href="/data-engineering/system-design/" variant="secondary">
        System design
      </Button>
      <Button href="/projects/" variant="secondary">
        Projects
      </Button>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="tech-h">
    <h2 id="tech-h" class="visually-hidden">
      Technologies
    </h2>
    <div class="tech-groups">
      {groups.map((g) => (
        <div class="tech-group">
          <h3>{g.label}</h3>
          <ul>
            {g.items.map((h) => (
              <li>
                <a href={h.url}>
                  {h.entry.data.shortName}
                  <small>→</small>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {pillars.length > 0 && (
    <section class="section section--tight" aria-labelledby="pillar-h">
      <h2 id="pillar-h" style="font-size: var(--fs-h3)">
        Pillar guides
      </h2>
      <ul class="link-list" style="margin-top: var(--sp-4)">
        {pillars.map((p) => (
          <li>
            <a class="row" href={p.url}>
              <span class="row__title">{p.title}</span>
              <span class="row__desc">{p.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</ContentLayout>
