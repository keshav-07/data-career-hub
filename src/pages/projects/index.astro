---
import { getItems } from "../../utils/content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { HOME } from "../../utils/breadcrumbs";
import Tile from "../../components/content/Tile.astro";
const all = await getItems("projects");
const order = ["Beginner", "Intermediate", "Advanced"];
const sorted = [...all].sort(
  (a, b) => order.indexOf(a.entry.data.level) - order.indexOf(b.entry.data.level),
);
---

<ContentLayout
  title="Data Engineering projects"
  seoTitle="Data Engineering Projects: Step-by-Step Guides"
  description="Portfolio projects for Data Engineers with requirements, architecture, testing, data quality, monitoring, interview questions and honest resume bullets."
  crumbs={[HOME, { label: "Projects" }]}
  eyebrow="Projects"
  deck="Projects that you can build, run and explain. Each one ends with the interview questions it prepares you for."
  indexable
>
  <section class="section section--tight">
    {order.map((level) => (
      <>
        <h2 class="group-title">{level}</h2>
        <ul class="tile-grid tile-grid--wide" role="list">
          {sorted
            .filter((p) => p.entry.data.level === level)
            .map((p) => (
              <li>
                <Tile
                  href={p.url}
                  level={p.entry.data.level}
                  title={p.title}
                  description={p.entry.data.problemStatement}
                  meta={[p.entry.data.technologies.slice(0, 3).join(" · ")]}
                />
              </li>
            ))}
        </ul>
      </>
    ))}
  </section>
</ContentLayout>
