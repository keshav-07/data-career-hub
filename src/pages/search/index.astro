---
import ContentLayout from "../../layouts/ContentLayout.astro";
import SearchPanel from "../../components/search/SearchPanel.astro";
import Tile from "../../components/content/Tile.astro";
import { HOME } from "../../utils/breadcrumbs";
---

<ContentLayout
  title="Search"
  description="Search DataDank guides, interview questions, projects, system design case studies and cheat sheets."
  crumbs={[HOME, { label: "Search" }]}
  noindex
>
  <section class="section section--tight" style="max-width: 760px">
    <div class="js-only">
      <SearchPanel idPrefix="page" />
    </div>
    <div class="no-js-only">
      <p>Search needs JavaScript. You can still browse everything from these hubs:</p>
    </div>
    <div style="margin-top: var(--sp-8)">
      <h2 style="font-size: var(--fs-xl)">Browse instead</h2>
      <ul class="tile-grid" role="list" style="margin-top: var(--sp-6)">
        <li>
          <Tile
            href="/data-engineering/"
            eyebrow="Learn"
            title="Courses"
            description="SQL, Python, Spark, warehousing, streaming and more."
          />
        </li>
        <li>
          <Tile
            href="/interview/"
            eyebrow="Interview"
            title="Interview preparation"
            description="Questions, case studies and company guides."
          />
        </li>
        <li>
          <Tile
            href="/projects/"
            eyebrow="Practice"
            title="Projects"
            description="Hands-on builds from beginner to advanced."
          />
        </li>
        <li>
          <Tile
            href="/roadmaps/"
            eyebrow="Plan"
            title="Roadmaps"
            description="The full roadmap and time-boxed study plans."
          />
        </li>
      </ul>
    </div>
  </section>
</ContentLayout>

<script>
  import { mountSearch } from "../../scripts/search";
  const root = document.querySelector<HTMLElement>("main [data-search-root]");
  if (root) mountSearch(root);
</script>
