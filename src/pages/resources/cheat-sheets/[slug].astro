---
import { render } from "astro:content";
import { getItems, getByRef, getHub, type ItemOf } from "../../../utils/content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import RelatedList from "../../../components/content/RelatedList.astro";
import NextStep from "../../../components/content/NextStep.astro";
import Callout from "../../../components/content/Callout.astro";
import { breadcrumbsFor } from "../../../utils/breadcrumbs";
import { relatedGroups } from "../../../utils/related";
import { sectionNav } from "../../../utils/navigation";

export async function getStaticPaths() {
  const all = await getItems("cheat-sheets");
  return all.map((s) => ({ params: { slug: s.id }, props: { ref: s.ref } }));
}
const item = (await getByRef(Astro.props.ref)) as ItemOf<"cheat-sheets">;
const { Content, headings } = await render(item.entry);
const crumbs = await breadcrumbsFor(item);
const { groups } = await relatedGroups(item);
const hub = (await Promise.all(item.technology.map((t) => getHub(t)))).find((h) => !!h);
const nav = await sectionNav("cheat-sheets", item.url);
---

<ArticleLayout
  nav={nav}
  item={item}
  crumbs={crumbs}
  headings={headings}
  eyebrow="Cheat sheet"
  deck={item.description}
  wide
>
  <Content components={{ Callout }} />
  <Fragment slot="footer">
    <RelatedList groups={groups} />
    {hub ? (
      <NextStep
        title="Go deeper"
        text="Cheat sheets are for revision. The full guides explain the reasoning."
        href={hub.url}
        label={`Open the ${hub.entry.data.shortName} hub`}
      />
    ) : (
      <NextStep
        title="Go deeper"
        text="Cheat sheets are for revision. The roadmap shows where each topic fits."
        href="/data-engineering/roadmap/"
        label="Open the Data Engineer roadmap"
      />
    )}
  </Fragment>
</ArticleLayout>
