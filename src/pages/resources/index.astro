---
import { getItems, getHub } from "../../utils/content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import Tile from "../../components/content/Tile.astro";
import { HOME } from "../../utils/breadcrumbs";
const sheets = (await getItems("cheat-sheets")).sort((a, b) => a.title.localeCompare(b.title));
const monos = await Promise.all(
  sheets.map(async (s) => (await getHub(s.technology[0]))?.entry.data.monogram),
);
---

<ContentLayout
  title="Data Engineering resources and cheat sheets"
  description="Dense, scannable reference sheets for SQL, PySpark and other Data Engineering tools, built for fast revision before an interview or a deploy."
  crumbs={[HOME, { label: "Resources" }]}
  eyebrow="Resources"
  deck="Reference material for quick revision. Each sheet says which versions it covers."
  indexable
>
  <section class="section section--tight">
    <h2 class="group-title">Cheat sheets</h2>
    <ul class="tile-grid" role="list">
      {sheets.map((s, i) => (
        <li>
          <Tile
            href={s.url}
            mono={monos[i]}
            eyebrow="Cheat sheet"
            title={s.entry.data.cheatTopic}
            description={s.description}
          />
        </li>
      ))}
    </ul>
  </section>
</ContentLayout>
