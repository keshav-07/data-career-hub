---
import ContentLayout from "../../layouts/ContentLayout.astro";
import PlannerRing from "../../components/planner/PlannerRing.astro";
import Tile from "../../components/content/Tile.astro";
import { HOME } from "../../utils/breadcrumbs";
import { TRACKERS, trackerRows, planDays } from "../../utils/curriculum";

const counts = await Promise.all(TRACKERS.map(async (t) => (await trackerRows(t.id)).length));
const total = counts.reduce((a, b) => a + b, 0);
const days = await planDays();
const hours = days.reduce((a, d) => a + d.hours, 0);
---

<ContentLayout
  title="Data Engineer Study Planner"
  seoTitle="Data Engineer Study Planner and Topic Trackers"
  description={`Track ${total} Data Engineering interview topics across SQL, DSA, PySpark, Snowflake, Kafka, Airflow, AWS, data modeling and system design, plus a 90-day plan.`}
  crumbs={[HOME, { label: "Study planner" }]}
  eyebrow="Study planner"
  deck={`Every topic you need for Data Engineering interviews, in ${TRACKERS.length} trackers with ${total} topics, each linked to its study material, plus a day-by-day 90-day plan. Your ticks are saved in this browser; no account needed.`}
  width="wide"
  indexable
>
  <div data-planner>
    <section class="section section--tight">
      <div class="progress-panel__head">
        <h2>Your readiness</h2>
        <p class="planner-actions js-only">
          <button type="button" class="btn btn--secondary btn--sm" data-pl-export>
            Back up
          </button>
          <button type="button" class="btn btn--secondary btn--sm" data-pl-import>
            Restore
          </button>
          <button type="button" class="btn btn--quiet btn--sm" data-pl-reset>
            Reset
          </button>
        </p>
      </div>
      <div class="rings">
        <PlannerRing tracker="" label="All topics" total={total} />
        <PlannerRing
          tracker="days"
          label="90-day plan"
          total={days.length}
          hours={hours}
          href="/planner/90-day-plan/"
        />
        {TRACKERS.map((t, i) => (
          <PlannerRing
            tracker={t.id}
            label={t.short}
            total={counts[i]}
            href={`/planner/${t.id}/`}
          />
        ))}
      </div>
      <p class="muted" style="margin-top: var(--sp-3); font-size: var(--fs-sm)">
        Progress is stored only in this browser. Use <strong>Back up</strong> to save a file you can
        restore on another device or after clearing your browser data.
      </p>
    </section>

    <section class="section">
      <h2 class="group-title">Topic trackers</h2>
      <ul class="tile-grid" role="list">
        {TRACKERS.map((t, i) => (
          <li>
            <Tile
              href={`/planner/${t.id}/`}
              title={t.title}
              description={t.blurb}
              meta={[`${counts[i]} topics`]}
            />
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2 class="group-title">Plan</h2>
      <ul class="tile-grid" role="list">
        <li>
          <Tile
            href="/planner/90-day-plan/"
            title="90-day study plan"
            description="A day-by-day plan: one topic per skill each day, mock interviews and applications, with weekly and monthly milestones."
            meta={[`${days.length} days`, `${hours} hours`]}
          />
        </li>
      </ul>
    </section>

    <section class="section">
      <div class="prose">
        <h2>How to use the planner</h2>
        <ol>
          <li>
            Pick a tracker and open a topic. Each one links straight to the section that teaches it.
          </li>
          <li>
            Tick <em>Studied</em> once you can explain it without notes, and <em>Practised</em> once
            you have written the code or query yourself.
          </li>
          <li>
            Revise on a schedule: after about a day, a week and a month. Use the revision ticks to
            see what is due.
          </li>
          <li>
            Rate your confidence from 1 to 5, and filter for 1–2 to find weak spots before a mock
            interview.
          </li>
          <li>
            Follow the 90-day plan if you want a ready-made order: about 3 hours on weekdays and 6
            at weekends.
          </li>
        </ol>
      </div>
    </section>
  </div>
</ContentLayout>

<script>
  import { initPlanner } from "../../scripts/planner";
  initPlanner();
</script>
