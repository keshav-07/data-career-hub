---
import ContentLayout from "../../../layouts/ContentLayout.astro";
import PlannerRing from "../../../components/planner/PlannerRing.astro";
import { HOME } from "../../../utils/breadcrumbs";
import { planDays, type PlanDay } from "../../../utils/curriculum";

const days = await planDays();
const hours = days.reduce((a, d) => a + d.hours, 0);
const trackedTopicCount = (day: PlanDay) =>
  day.tasks.reduce((count, task) => count + task.topics.filter((topic) => topic.key).length, 0);
const phases = [...new Set(days.map((d) => d.phase))];
const goalOf = (phase: string) => days.find((d) => d.phase === phase)?.phaseGoal;
const weeksOf = (phase: string) => {
  const map = new Map<number, PlanDay[]>();
  for (const d of days.filter((x) => x.phase === phase)) {
    map.set(d.week, [...(map.get(d.week) ?? []), d]);
  }
  return [...map.entries()];
};
const milestone = (week: number) => days.find((d) => d.week === week && d.weekly)?.weekly;
---

<ContentLayout
  title="90-Day Data Engineer Study Plan"
  description="A prerequisite-first 90-day data-engineering interview plan with per-task time, hands-on exercises, interview questions and weekly milestones."
  crumbs={[HOME, { label: "Study planner", href: "/planner/" }, { label: "90-day plan" }]}
  eyebrow="Study planner"
  deck={`${days.length} days, ${hours} planned hours: 3 hours on weekdays and 6 at weekends. Build foundations first, then reliable pipelines and interview readiness. Every day includes a hands-on exercise, an interview question and a clear outcome.`}
  width="wide"
  indexable
>
  <div data-planner>
    <section class="section section--tight">
      <div class="rings planner-head">
        <PlannerRing tracker="days" label="Days completed" total={days.length} hours={hours} />
        <div class="planner-head__text">
          <label class="pl-start js-only">
            <span>Your start date (optional)</span>
            <input type="date" data-pl-start />
          </label>
          <p class="muted" style="font-size: var(--fs-sm)">
            Set a Saturday start date to align the 6-hour weekend and 3-hour weekday schedule with
            calendar dates. Saved in this browser only.
          </p>
        </div>
      </div>
      <nav class="pl-jump" aria-label="Jump to phase">
        {phases.map((p, i) => (
          <a href={`#phase-${i + 1}`}>{p}</a>
        ))}
      </nav>
    </section>

    {phases.map((phase, pi) => (
      <section class="section section--tight" aria-labelledby={`phase-${pi + 1}`}>
        <h2 id={`phase-${pi + 1}`}>{phase}</h2>
        {goalOf(phase) && <p class="pl-phase-goal">{goalOf(phase)}</p>}
        {weeksOf(phase).map(([week, list]) => (
          <div class="pl-week">
            <h3 id={`week-${week}`}>
              Week {week}
              {milestone(week) && (
                <span class="pl-milestone">{milestone(week)!.replace(/^Wk\d+:\s*/, "")}</span>
              )}
            </h3>
            <ol class="pl-days" role="list">
              {list.map((d) => (
                <li class="pl-day" data-pl-day-card id={`day-${d.day}`}>
                  <div class="day-card__head pl-day__head">
                    <div class="day-card__heading pl-day__heading">
                      <p class="day-card__eyebrow">
                        <span>Daily focus</span>
                        <span class="day-card__pill">
                          {d.day === 1 ? "Start here" : `Week ${d.week}`}
                        </span>
                      </p>
                      <p class="pl-day__day">
                        <span class="pl-day__number">Day {d.day}</span>
                        <span class="pl-day__total">/ {days.length}</span>
                      </p>
                      <p class="pl-day__date" data-pl-date={d.day}></p>
                      <h3 class="day-card__title pl-day__theme">{d.theme}</h3>
                    </div>
                    <PlannerRing
                      tracker="days"
                      label={`Plan progress, day ${d.day}`}
                      total={days.length}
                      hours={hours}
                    />
                  </div>
                  <ul class="pl-tasks" role="list">
                    {d.tasks.map((t) => (
                      <li class="pl-task">
                        <div class="pl-task__head">
                          <span class="pl-tasks__skill">{t.track}</span>
                          <span class="pl-task__meta">
                            {t.minutes} min · {t.kind}
                          </span>
                        </div>
                        <ul class="pl-task__topics" role="list">
                          {t.topics.map((item) => (
                            <li class="day-task" title={`${t.track}: ${item.topic}`}>
                              {item.href ? (
                                <a class="day-task__link" href={item.href}>
                                  <span class="day-task__skill">{t.track}</span>
                                  <span class="day-task__topic">{item.topic}</span>
                                </a>
                              ) : (
                                <span class="day-task__link">
                                  <span class="day-task__skill">{t.track}</span>
                                  <span class="day-task__topic">{item.topic}</span>
                                </span>
                              )}
                              {item.key && (
                                <input
                                  type="checkbox"
                                  class="day-task__check js-only"
                                  data-pl-key={item.key}
                                  data-pl-field="learn"
                                  aria-label={`Studied: ${t.track}, ${item.topic}`}
                                />
                              )}
                            </li>
                          ))}
                          {t.practice?.map((item) => (
                            <li class="day-task" title={`${t.track} practice: ${item.title}`}>
                              <a
                                class="day-task__link"
                                href={item.url}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                <span class="day-task__skill">{t.track} practice</span>
                                <span class="day-task__topic">{item.title} ↗</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                  <div class="day-card__bar">
                    <p class="day-card__foot">
                      <span
                        class="day-card__count js-only"
                        data-pl-topic-count={d.day}
                        data-total={trackedTopicCount(d)}
                      >
                        0/{trackedTopicCount(d)} topics
                      </span>
                      <span>
                        {d.hours} h · {trackedTopicCount(d)} planned topics
                      </span>
                    </p>
                    <label class="day-card__done js-only">
                      <input
                        type="checkbox"
                        data-pl-day={d.day}
                        data-hours={d.hours}
                        aria-label={`Day ${d.day} complete`}
                      />
                      <span>Mark complete</span>
                    </label>
                  </div>
                  <dl class="pl-day-guidance">
                    <div>
                      <dt>Exercise</dt>
                      <dd>{d.exercise}</dd>
                    </div>
                    <div>
                      <dt>Interview question</dt>
                      <dd>{d.interviewQuestion}</dd>
                    </div>
                    <div>
                      <dt>Outcome</dt>
                      <dd>{d.outcome}</dd>
                    </div>
                  </dl>
                  {d.monthly && (
                    <p class="pl-month">
                      <strong>{d.monthly}</strong>
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))}
  </div>
</ContentLayout>

<script>
  import { initPlanner } from "../../../scripts/planner";
  initPlanner();

  function updateDayTopicCounts() {
    document.querySelectorAll<HTMLElement>("[data-pl-topic-count]").forEach((count) => {
      const card = count.closest<HTMLElement>("[data-pl-day-card]");
      const checks = card?.querySelectorAll<HTMLInputElement>(
        'input[data-pl-key][data-pl-field="learn"]',
      );
      const total = Number(count.dataset.total) || 0;
      const completed = checks ? [...checks].filter((check) => check.checked).length : 0;
      count.textContent = `${completed}/${total} topics`;
    });
  }

  document.addEventListener("planner:change", updateDayTopicCounts);
  updateDayTopicCounts();
</script>
