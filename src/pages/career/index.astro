---
import { getItems } from "../../utils/content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import Tile from "../../components/content/Tile.astro";
import { HOME } from "../../utils/breadcrumbs";
const guides = (await getItems("articles")).filter((a) => a.entry.data.section === "career");
const plans = (await getItems("roadmaps")).filter(
  (r) => r.entry.data.roadmapType === "career-transition",
);
---

<ContentLayout
  title="Data Engineering career guidance"
  description="Practical career guidance for Data Engineers: explaining projects, resumes, switching roles and planning your job search."
  crumbs={[HOME, { label: "Career" }]}
  eyebrow="Career"
  deck="Practical guidance on turning what you learn into a job offer."
  indexable
>
  <section class="section section--tight">
    <h2 class="group-title">Guides</h2>
    <ul class="tile-grid tile-grid--wide" role="list">
      {guides.map((a) => (
        <li>
          <Tile
            href={a.url}
            title={a.title}
            description={a.description}
            meta={[`${a.minutes} min read`]}
          />
        </li>
      ))}
    </ul>
    <h2 class="group-title">Career plans</h2>
    <ul class="tile-grid tile-grid--wide" role="list">
      {plans.map((r) => (
        <li>
          <Tile
            href={r.url}
            title={r.title}
            description={r.description}
            meta={[`${r.entry.data.stages.length} stages`]}
          />
        </li>
      ))}
    </ul>
    <h2 class="group-title">Put it into practice</h2>
    <ul class="tile-grid" role="list">
      <li>
        <Tile
          href="/projects/"
          eyebrow="Practice"
          title="Projects"
          description="Build projects you can demo and explain in interviews."
        />
      </li>
      <li>
        <Tile
          href="/interview/"
          eyebrow="Interview"
          title="Interview preparation"
          description="Questions, case studies and company guides."
        />
      </li>
    </ul>
  </section>
</ContentLayout>
