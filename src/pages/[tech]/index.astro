---
import { render } from "astro:content";
import { getItems, getByRef, sortByTitle, type Item } from "../../utils/content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import IndexMeta from "../../components/content/IndexMeta.astro";
import ContentRow from "../../components/content/ContentRow.astro";
import Button from "../../components/content/Button.astro";
import { breadcrumbsFor } from "../../utils/breadcrumbs";
import { TECH_GROUP_LABELS } from "../../data/site";

export async function getStaticPaths() {
  const hubs = await getItems("technologies");
  return hubs.map((hub) => ({ params: { tech: hub.id }, props: { hubRef: hub.ref } }));
}

const { hubRef } = Astro.props;
const hub = (await getByRef(hubRef)) as Item & { collection: "technologies" };
const tech = hub.id;
const d = hub.entry.data;
const { Content } = await render(hub.entry);

const articles = (await getItems("articles")).filter((a) => a.technology.includes(tech) && a.entry.data.section === "learn");
const byLevel = (lvl: string) => sortByTitle(articles.filter((a) => a.difficulty === lvl));
const questions = (await getItems("interview-questions")).filter((q) => q.technology.includes(tech));
const projects = (await getItems("projects")).filter((p) => p.technology.includes(tech) || p.entry.data.technologies.includes(tech));
const learnFirst = (await Promise.all(d.whatToLearnFirst.map((r) => getByRef(r)))).filter((x): x is Item => !!x);
const cheat = d.cheatSheet ? await getByRef(d.cheatSheet) : undefined;
const related = (await Promise.all(d.relatedTechnologies.map((t) => getByRef(`technologies:${t}`)))).filter((x): x is Item => !!x);
const crumbs = await breadcrumbsFor(hub);
const levels = [
  { id: "beginner", label: "Beginner", items: byLevel("Beginner") },
  { id: "intermediate", label: "Intermediate", items: byLevel("Intermediate") },
  { id: "advanced", label: "Advanced", items: byLevel("Advanced") },
].filter((l) => l.items.length);
const nav = [
  { href: "#overview", label: "Overview" },
  learnFirst.length ? { href: "#learn-first", label: "Learn first" } : null,
  ...levels.map((l) => ({ href: `#${l.id}`, label: l.label })),
  questions.length ? { href: "#interview", label: "Interview" } : null,
  projects.length ? { href: "#projects", label: "Projects" } : null,
  cheat ? { href: "#cheat-sheet", label: "Cheat sheet" } : null,
  related.length ? { href: "#related", label: "Related" } : null,
].filter((x): x is { href: string; label: string } => !!x);
---

<ContentLayout
  title={d.title}
  description={d.description}
  crumbs={crumbs}
  eyebrow={TECH_GROUP_LABELS[d.group]}
  deck={d.description}
  indexable
>
  <IndexMeta type="Technology hub" technology={tech} />
  <nav class="tech-hub-nav" aria-label={`${d.shortName} sections`} style="margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter)">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>

  <section id="overview" class="section section--tight" aria-labelledby="overview-h">
    <div class="two-col two-col--aside">
      <div class="prose">
        <h2 id="overview-h">Overview</h2>
        <Content />
      </div>
      <aside aria-label="Key facts">
        <h2 class="eyebrow" style="font-size: var(--fs-sm)">Key facts</h2>
        <ul class="link-list" style="margin-top: var(--sp-2)">
          {d.keyFacts.map((f) => <li style="padding: var(--sp-3) 0">{f}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  {
    learnFirst.length > 0 && (
      <section id="learn-first" class="section section--tight" aria-labelledby="lf-h">
        <h2 id="lf-h" style="font-size: var(--fs-h3)">What to learn first</h2>
        <ol class="ranked" style="margin-top: var(--sp-4)">
          {learnFirst.map((i) => (
            <li>
              <a href={i.url}>
                <span class="ranked__title">{i.title}<span class="ranked__sub">{i.description}</span></span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    levels.map((l) => (
      <section id={l.id} class="section section--tight" aria-labelledby={`${l.id}-h`}>
        <h2 id={`${l.id}-h`} style="font-size: var(--fs-h3)">{l.label}</h2>
        <ul class="link-list" style="margin-top: var(--sp-4)">
          {l.items.map((i) => <li><ContentRow item={i} /></li>)}
        </ul>
      </section>
    ))
  }

  {
    questions.length > 0 && (
      <section id="interview" class="section section--tight" aria-labelledby="int-h">
        <h2 id="int-h" style="font-size: var(--fs-h3)">{d.shortName} interview preparation</h2>
        <ul class="link-list" style="margin-top: var(--sp-4)">
          {questions.map((q) => <li><ContentRow item={q} /></li>)}
        </ul>
        <div style="margin-top: var(--sp-4)">
          <Button href={`/interview/${tech}/`} variant="secondary">All {d.shortName} interview questions</Button>
        </div>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section id="projects" class="section section--tight" aria-labelledby="proj-h">
        <h2 id="proj-h" style="font-size: var(--fs-h3)">Projects using {d.shortName}</h2>
        <ul class="link-list" style="margin-top: var(--sp-4)">
          {projects.map((p) => <li><ContentRow item={p} /></li>)}
        </ul>
      </section>
    )
  }

  {
    cheat && (
      <section id="cheat-sheet" class="section section--tight" aria-labelledby="cs-h">
        <h2 id="cs-h" style="font-size: var(--fs-h3)">Cheat sheet</h2>
        <ul class="link-list" style="margin-top: var(--sp-4)"><li><ContentRow item={cheat} /></li></ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section id="related" class="section section--tight" aria-labelledby="rel-h">
        <h2 id="rel-h" style="font-size: var(--fs-h3)">Related technologies</h2>
        <p class="cluster" style="margin-top: var(--sp-3)">
          {related.map((r) => <a class="tag" href={r.url}>{r.entry.data.shortName}</a>)}
        </p>
      </section>
    )
  }
</ContentLayout>
