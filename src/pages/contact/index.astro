---
import ContentLayout from "../../layouts/ContentLayout.astro";
import { HOME } from "../../utils/breadcrumbs";
import { SITE } from "../../data/site";
---

<ContentLayout
  title="Contact"
  description="Contact DataDank by email to report a factual error or broken link, suggest a topic, or send feedback on the 90-day Data Engineering plan."
  crumbs={[HOME, { label: "Contact" }]}
  eyebrow="Contact"
  deck="Corrections and suggestions are welcome."
  indexable
>
  <section class="section section--tight">
    <div class="prose">
      <h2>Reporting an issue</h2>
      <p>
        Please include the page address, what looks wrong and, if you can, a link to the
        documentation that shows the correct behaviour. Factual corrections are the most useful
        reports.
      </p>
      <h2>How to reach us</h2>
      {SITE.contactEmail ? (
        <p>
          Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> for corrections,
          broken links, content suggestions, feedback on the 90-day plan or general enquiries.
          Messages are read by the person who maintains DataDank.
        </p>
      ) : (
        <p>
          A public contact address has not been published yet. This page will list one as soon as it
          is configured.
        </p>
      )}
      <h2>What happens to a correction</h2>
      <p>
        A reported error is checked against the official documentation or by running the example.
        If it is confirmed, the page is fixed and its "last reviewed" date changes. Dates are only
        changed when a page is substantively updated.
      </p>
      <p>This site does not use a contact form, so no message data is collected on this page.</p>
    </div>
  </section>
</ContentLayout>
