---
import ContentLayout from "../../layouts/ContentLayout.astro";
import { HOME } from "../../utils/breadcrumbs";
---

<ContentLayout
  title="Terms of use"
  description="Terms for using Data Career Hub: educational content provided as is, with permitted use, intellectual property and external-link terms."
  crumbs={[HOME, { label: "Terms" }]}
  eyebrow="Legal"
  indexable
>
  <section class="section section--tight">
    <div class="prose">
      <h2>Use of the site</h2>
      <p>Data Career Hub publishes free educational content. You may read it, link to it and quote short excerpts with attribution. Please do not republish whole pages or scrape the site at a rate that affects other readers.</p>
      <h2>Content is provided as is</h2>
      <p>We work to keep content accurate, but technologies change and mistakes happen. Content is provided without warranty of any kind. See the <a href="/disclaimer/">disclaimer</a> for more.</p>
      <h2>Intellectual property</h2>
      <p>Text, diagrams and code samples written for this site belong to Data Career Hub unless a page says otherwise. Product names and trademarks belong to their owners and are used only to describe the technologies discussed.</p>
      <h2>External links</h2>
      <p>We are not responsible for the content or practices of external sites we link to.</p>
      <h2>Changes</h2>
      <p>These terms may change as the site evolves. The current version is always on this page.</p>
    </div>
  </section>
</ContentLayout>
