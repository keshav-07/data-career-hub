---
import { render } from "astro:content";
import { getItems, getByRef, type ItemOf } from "../../utils/content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import RoadmapNodes from "../../components/roadmap/RoadmapNodes.astro";
import RelatedList from "../../components/content/RelatedList.astro";
import NextStep from "../../components/content/NextStep.astro";
import { breadcrumbsFor } from "../../utils/breadcrumbs";
import { relatedGroups } from "../../utils/related";

export async function getStaticPaths() {
  const all = (await getItems("roadmaps")).filter((r) => r.entry.data.roadmapType !== "data-engineer");
  return all.map((r) => ({ params: { slug: r.id }, props: { ref: r.ref } }));
}
const item = (await getByRef(Astro.props.ref)) as ItemOf<"roadmaps">;
const d = item.entry.data;
const { Content, headings } = await render(item.entry);
const crumbs = await breadcrumbsFor(item);
const { groups } = await relatedGroups(item);
---

<ArticleLayout item={item} crumbs={crumbs} headings={headings} eyebrow="Study plan" deck={item.description} meta={[d.difficulty]}>
  <Content />
  <h2 id="plan">The plan</h2>
  <RoadmapNodes stages={d.stages} />
  <Fragment slot="footer">
    <RelatedList groups={groups} />
    <NextStep title="See the full roadmap" text="Every plan maps onto the same ordered Data Engineering journey." href="/data-engineering/roadmap/" label="Open the Data Engineer roadmap" />
  </Fragment>
</ArticleLayout>
