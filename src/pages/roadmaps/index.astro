---
import { plural } from "../../utils/dates";
import { getItems } from "../../utils/content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import Tile from "../../components/content/Tile.astro";
import { HOME } from "../../utils/breadcrumbs";
const all = await getItems("roadmaps");
const groups = [
  { label: "The roadmap", type: "data-engineer" },
  { label: "Study plans", type: "study-plan" },
  { label: "Career plans", type: "career-transition" },
].map((g) => ({
  ...g,
  items: all
    .filter((r) => r.entry.data.roadmapType === g.type)
    .sort((a, b) => a.title.localeCompare(b.title)),
}));
---

<ContentLayout
  title="Data Engineering roadmaps and study plans"
  description="Follow the full Data Engineer roadmap or a time-boxed study plan that sequences concepts, practice, projects and interview preparation."
  crumbs={[HOME, { label: "Roadmaps" }]}
  eyebrow="Roadmaps"
  deck="A roadmap shows the order. A study plan fits that order into a fixed number of days."
  indexable
>
  <section class="section section--tight">
    {groups
      .filter((g) => g.items.length)
      .map((g) => (
        <>
          <h2 class="group-title">{g.label}</h2>
          <ul class="tile-grid tile-grid--wide" role="list">
            {g.items.map((r) => (
              <li>
                <Tile
                  href={r.url}
                  title={r.title}
                  description={r.description}
                  level={r.entry.data.difficulty}
                  meta={[plural(r.entry.data.stages.length, "stage")]}
                />
              </li>
            ))}
          </ul>
        </>
      ))}
  </section>
</ContentLayout>
