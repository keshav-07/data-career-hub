---
import { getItems, techLabel } from "../../utils/content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import Button from "../../components/content/Button.astro";
import { HOME } from "../../utils/breadcrumbs";

const qs = await getItems("interview-questions");
const counts = new Map<string, number>();
qs.forEach((q) => counts.set(q.id.split("/")[0], (counts.get(q.id.split("/")[0]) ?? 0) + 1));
const groups = await Promise.all(
  [...counts.entries()].map(async ([t, n]) => ({ t, n, label: await techLabel(t) })),
);
const companies = await getItems("company-guides");
const designs = await getItems("system-designs");
---

<ContentLayout
  title="Data Engineering interview preparation"
  description="Practise Data Engineering interview questions by technology, study system-design case studies and prepare for specific companies with clearly labelled evidence."
  crumbs={[HOME, { label: "Interview" }]}
  eyebrow="Interview"
  deck="Three focused routes: technology questions, system design and company preparation. Every answer starts with something you can say out loud."
  indexable
>
  <section class="section" aria-labelledby="lanes-h">
    <h2 id="lanes-h" class="visually-hidden">
      Interview routes
    </h2>
    <div class="lanes">
      <div class="lane">
        <h3>Technology interviews</h3>
        <p>
          Short answer first, then the reasoning, mistakes to avoid and the follow-ups interviewers
          ask next.
        </p>
        <ul class="link-list" style="margin-top: var(--sp-4)">
          {groups.map((g) => (
            <li>
              <a class="row" href={`/interview/${g.t}/`}>
                <span class="row__title">{g.label}</span>
                <span class="row__meta">
                  {g.n} question{g.n === 1 ? "" : "s"}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="lane">
        <h3>System design</h3>
        <p>
          Walk through requirements, architecture, reliability and trade-offs for common data
          platform problems.
        </p>
        <Button href="/data-engineering/system-design/" variant="secondary">
          {designs.length} case stud{designs.length === 1 ? "y" : "ies"}
        </Button>
      </div>
      <div class="lane">
        <h3>Company preparation</h3>
        <p>
          Preparation guides that separate attributed reports from representative practice
          questions.
        </p>
        <Button href="/interview/companies/" variant="secondary">
          {companies.length} compan{companies.length === 1 ? "y" : "ies"}
        </Button>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="plan-h">
    <div class="section-head">
      <p class="eyebrow">Structured plan</p>
      <h2 id="plan-h">Not sure where to start?</h2>
      <p>Follow a time-boxed plan that sequences concepts, practice and projects.</p>
    </div>
    <Button href="/roadmaps/">Browse roadmaps and study plans</Button>
  </section>
</ContentLayout>
