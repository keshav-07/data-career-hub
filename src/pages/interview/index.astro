---
import { plural } from "../../utils/dates";
import { getItems, getHub, techLabel } from "../../utils/content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import Tile from "../../components/content/Tile.astro";
import { HOME } from "../../utils/breadcrumbs";

const qs = await getItems("interview-questions");
const counts = new Map<string, { n: number; easy: number; medium: number; hard: number }>();
for (const q of qs) {
  const t = q.id.split("/")[0];
  const c = counts.get(t) ?? { n: 0, easy: 0, medium: 0, hard: 0 };
  c.n++;
  c[q.entry.data.difficulty.toLowerCase() as "easy" | "medium" | "hard"]++;
  counts.set(t, c);
}
const groups = await Promise.all(
  [...counts.entries()].map(async ([t, c]) => ({
    t,
    c,
    label: await techLabel(t),
    mono: (await getHub(t))?.entry.data.monogram ?? (t === "data-engineering" ? "DE" : undefined),
  })),
);
groups.sort((a, b) => b.c.n - a.c.n || a.label.localeCompare(b.label));
const companies = await getItems("company-guides");
const designs = await getItems("system-designs");
---

<ContentLayout
  title="Data Engineering interview preparation"
  description="Practise Data Engineering interview questions by technology, study system-design case studies and prepare for specific companies with clearly labelled evidence."
  crumbs={[HOME, { label: "Interview" }]}
  eyebrow="Interview"
  deck="Every answer starts with something you can say out loud, then explains the details and the follow-ups."
  indexable
>
  <section class="section section--tight" aria-labelledby="all-h">
    <h2 id="all-h" class="visually-hidden">
      All questions
    </h2>
    <a class="continue-link" href="/interview/questions/">
      <span>
        <strong>All {qs.length} interview questions</strong> in one filterable list, with progress
        you can tick off.
      </span>
      <span aria-hidden="true">→</span>
    </a>
  </section>

  <section class="section section--tight" aria-labelledby="topics-h">
    <h2 id="topics-h" class="group-title">
      Questions by topic
    </h2>
    <ul class="tile-grid" role="list">
      {groups.map((g) => (
        <li>
          <Tile
            href={`/interview/${g.t}/`}
            mono={g.mono ?? g.label.slice(0, 2)}
            title={`${g.label} interview questions`}
            meta={[
              plural(g.c.n, "question"),
              g.c.easy > 0 && `${g.c.easy} easy`,
              g.c.medium > 0 && `${g.c.medium} medium`,
              g.c.hard > 0 && `${g.c.hard} hard`,
            ]}
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="section section--tight" aria-labelledby="more-h">
    <h2 id="more-h" class="group-title">
      Beyond technology questions
    </h2>
    <ul class="tile-grid" role="list">
      <li>
        <Tile
          href="/data-engineering/system-design/"
          eyebrow="System design"
          title="Case studies"
          description="Walk through requirements, architecture, reliability and trade-offs."
          meta={[`${designs.length} case studies`]}
        />
      </li>
      <li>
        <Tile
          href="/interview/companies/"
          eyebrow="Company preparation"
          title="Company guides"
          description="Preparation that separates attributed information from practice questions."
          meta={[`${companies.length} companies`]}
        />
      </li>
      <li>
        <Tile
          href="/roadmaps/interview-preparation-roadmap/"
          eyebrow="Plan"
          title="Interview preparation roadmap"
          description="What each interview round tests and how to prepare for it."
        />
      </li>
      <li>
        <Tile
          href="/roadmaps/60-day-interview-preparation/"
          eyebrow="Plan"
          title="60-day interview plan"
          description="Eight weeks from SQL drills to mock interviews."
        />
      </li>
    </ul>
  </section>
</ContentLayout>
