---
import { getItems, getHub, techLabel } from "../../../utils/content";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import IndexMeta from "../../../components/content/IndexMeta.astro";
import Tile from "../../../components/content/Tile.astro";
import QuestionTable from "../../../components/interview/QuestionTable.astro";
import { HOME } from "../../../utils/breadcrumbs";
import { inLearningOrder, questionOrder } from "../../../utils/curriculum";

export async function getStaticPaths() {
  const qs = await getItems("interview-questions");
  const techs = [...new Set(qs.map((q) => q.id.split("/")[0]))];
  return techs.map((tech) => ({ params: { tech } }));
}

const ORDER = ["Easy", "Medium", "Hard"];
const { tech } = Astro.params;
const label = await techLabel(tech!);
const qs = inLearningOrder(
  tech!,
  (await getItems("interview-questions"))
    .filter((q) => q.id.startsWith(`${tech}/`))
    .sort(
      (a, b) =>
        ORDER.indexOf(a.entry.data.difficulty) - ORDER.indexOf(b.entry.data.difficulty) ||
        a.title.localeCompare(b.title),
    ),
);
// Topic column when the planner orders this course by topic (DSA).
const order = questionOrder(tech!);
const topicOf = order.size
  ? Object.fromEntries(qs.map((q) => [q.ref, order.get(q.ref)?.topic ?? "More"]))
  : undefined;
const articles = (await getItems("articles")).filter(
  (a) => a.technology[0] === tech && a.entry.data.section === "learn",
);
const hub = await getHub(tech!);
---

<ContentLayout
  title={`${label} interview questions${/data engineering/i.test(label) ? "" : " for Data Engineers"}`}
  seoTitle={`${label} Interview Questions${/data engineering/i.test(label) ? " and Answers" : " for Data Engineers"}`}
  description={`${qs.length} ${label} interview questions for Data Engineers, each with a short answer you can say out loud, a deeper explanation, common mistakes and follow-ups.`}
  crumbs={[HOME, { label: "Interview", href: "/interview/" }, { label }]}
  eyebrow="Interview preparation"
  deck="Every question starts with a direct answer you could say out loud, then explains why, when and what goes wrong. Tick questions off as you practise."
  indexable
>
  <IndexMeta type="Interview hub" technology={tech} />
  <section class="section section--tight" aria-labelledby="qs-h">
    <h2 id="qs-h" class="group-title">
      All {label} questions
    </h2>
    <QuestionTable questions={qs} topicOf={topicOf} caption={`${label} interview questions`} />
  </section>

  {articles.length > 0 && (
    <section class="section section--tight" aria-labelledby="concept-h">
      <h2 id="concept-h" class="group-title">
        Concept review
      </h2>
      <ul class="tile-grid" role="list">
        {articles.map((a) => (
          <li>
            <Tile href={a.url} eyebrow="Lesson" title={a.title} level={a.difficulty} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section section--tight" aria-labelledby="more-h">
    <h2 id="more-h" class="group-title">
      Continue preparing
    </h2>
    <ul class="tile-grid" role="list">
      {hub && (
        <li>
          <Tile
            href={hub.url}
            mono={hub.entry.data.monogram}
            eyebrow="Course"
            title={`${label} course`}
            description="Ordered lessons, projects and a cheat sheet."
          />
        </li>
      )}
      <li>
        <Tile
          href="/interview/questions/"
          eyebrow="Interview"
          title="All interview questions"
          description="Every question across all topics in one filterable list."
        />
      </li>
      <li>
        <Tile
          href="/data-engineering/system-design/"
          eyebrow="System design"
          title="Case studies"
          description="Practise full data platform designs."
        />
      </li>
      <li>
        <Tile
          href="/interview/companies/"
          eyebrow="Companies"
          title="Company preparation"
          description="Guides with attributed sources and practice questions."
        />
      </li>
    </ul>
  </section>
</ContentLayout>
