---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/content/Button.astro";
import Tile from "../components/content/Tile.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for does not exist or has moved."
  noindex
>
  <section class="not-found">
    <div class="container" style="max-width: 900px">
      <p class="eyebrow">404</p>
      <h1 style="margin-top: var(--sp-3)">We could not find that page</h1>
      <p class="deck" style="margin-top: var(--sp-4)">
        The link may be out of date or the page may have moved. Try search, or start from one of the
        main sections.
      </p>
      <div class="cluster" style="margin-top: var(--sp-8)">
        <button type="button" class="btn btn--primary js-only" data-search-open>
          Search the site
        </button>
        <Button href="/data-engineering/roadmap/" variant="secondary">
          Data Engineering roadmap
        </Button>
        <Button href="/" variant="secondary">
          Home
        </Button>
      </div>
      <ul class="tile-grid" role="list" style="margin-top: var(--sp-6)">
        <li>
          <Tile
            href="/data-engineering/"
            eyebrow="Learn"
            title="Courses"
            description="SQL, Python, Spark, warehousing, streaming and more."
          />
        </li>
        <li>
          <Tile
            href="/interview/"
            eyebrow="Interview"
            title="Interview preparation"
            description="Questions, case studies and company guides."
          />
        </li>
        <li>
          <Tile
            href="/projects/"
            eyebrow="Practice"
            title="Projects"
            description="Hands-on builds from beginner to advanced."
          />
        </li>
        <li>
          <Tile
            href="/roadmaps/"
            eyebrow="Plan"
            title="Roadmaps"
            description="The full roadmap and time-boxed study plans."
          />
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
