---
import { plural } from "../utils/dates";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/content/Button.astro";
import Tile from "../components/content/Tile.astro";
import { getItems, getByRef } from "../utils/content";
import { getCourse } from "../utils/navigation";
import { SITE, TECH_GROUP_LABELS } from "../data/site";

const hubs = (await getItems("technologies")).sort(
  (a, b) => a.entry.data.order - b.entry.data.order,
);
const courses = await Promise.all(hubs.map((h) => getCourse(h.id)));
const roadmap = await getByRef("roadmaps:data-engineer-roadmap");
const stages = roadmap && roadmap.collection === "roadmaps" ? roadmap.entry.data.stages : [];
const projects = await getItems("projects");
const featuredProjects = ["Beginner", "Intermediate", "Advanced"]
  .map((l) => projects.find((p) => p.entry.data.level === l))
  .filter((p): p is NonNullable<typeof p> => !!p);
const featured = (await getItems("articles")).filter((a) => a.entry.data.featured).slice(0, 4);
const designs = await getItems("system-designs");
const companies = await getItems("company-guides");
const questions = await getItems("interview-questions");
const lessonCount = courses.reduce((n, c) => n + (c?.lessons.length ?? 0), 0);
---

<BaseLayout
  title={SITE.name}
  seoTitle="Learn Data Engineering and Prepare for Interviews"
  description={SITE.description}
>
  <section class="hero">
    <div class="container">
      <div class="hero__inner">
        <p class="eyebrow">Data Engineering · courses, interview preparation and projects</p>
        <h1>Learn Data Engineering. Prepare smarter. Get job ready.</h1>
        <p class="deck">
          Structured courses for every core technology, interview questions with direct answers, and
          projects you can explain, in one place.
        </p>
        <div class="hero__actions">
          <Button href="/data-engineering/roadmap/" size="lg" fullWidthOnMobile>
            Start Data Engineering Roadmap
          </Button>
          <Button href="/interview/" variant="secondary" size="lg" fullWidthOnMobile>
            Explore Interview Preparation
          </Button>
        </div>
        <dl class="hero__stats">
          <div>
            <dt>Courses</dt>
            <dd>{hubs.length}</dd>
          </div>
          <div>
            <dt>Lessons</dt>
            <dd>{lessonCount}</dd>
          </div>
          <div>
            <dt>Interview questions</dt>
            <dd>{questions.length}</dd>
          </div>
          <div>
            <dt>Projects</dt>
            <dd>{projects.length}</dd>
          </div>
        </dl>
        <div class="progress-panel js-only" aria-labelledby="progress-h">
          <div class="progress-panel__head">
            <h2 id="progress-h">Your progress</h2>
            <span class="muted" style="font-size: var(--fs-sm)">
              Saved in this browser only, no account needed.
              <button type="button" class="link-btn" data-progress-reset data-progress-has hidden>
                Reset
              </button>
            </span>
          </div>
          <div class="rings">
            {[
              { kind: "lesson", label: "Lessons", total: lessonCount },
              { kind: "question", label: "Interview questions", total: questions.length },
              { kind: "project", label: "Projects", total: projects.length },
            ].map((r) => (
              <div
                class="ring"
                data-ring
                data-kind={r.kind}
                data-total={r.total}
                data-label={r.label}
                role="img"
              >
                <span class="ring__dial" aria-hidden="true">
                  <span class="ring__value" data-ring-value>
                    0%
                  </span>
                </span>
                <span aria-hidden="true">
                  <span class="ring__label">{r.label}</span>
                  <span class="ring__detail" data-ring-detail>
                    0 of {r.total}
                  </span>
                </span>
              </div>
            ))}
          </div>
          <p
            class="muted"
            data-progress-empty
            style="margin-top: var(--sp-3); font-size: var(--fs-sm)"
          >
            Open a lesson or tick off an interview question and your progress appears here.
          </p>
          <a class="continue-link" href="/data-engineering/" data-continue hidden>
            <span>
              Continue where you left off: <strong data-continue-title></strong>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="learn-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Courses</p>
        <h2 id="learn-h">Pick a technology and start learning</h2>
        <p>Each course has ordered lessons, interview questions, projects and a cheat sheet.</p>
      </div>
      <ul class="tile-grid" role="list">
        {hubs.map((h, i) => (
          <li>
            <Tile
              href={h.url}
              mono={h.entry.data.monogram}
              eyebrow={TECH_GROUP_LABELS[h.entry.data.group]}
              title={h.entry.data.shortName}
              description={h.description}
              meta={[
                plural(courses[i]?.lessons.length ?? 0, "lesson"),
                (courses[i]?.questions.length ?? 0) > 0 &&
                  plural(courses[i]?.questions.length ?? 0, "question"),
              ]}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {stages.length > 0 && (
    <section class="section" aria-labelledby="road-h">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Roadmap</p>
          <h2 id="road-h">Data Engineer roadmap</h2>
          <p>From beginner foundations to job ready, in {stages.length} ordered stages.</p>
        </div>
        <ol class="roadmap-preview">
          {stages.map((s) => (
            <li>
              <a
                href={`/data-engineering/roadmap/#stage-${s.id}`}
                style="color:inherit;text-decoration:none"
              >
                <strong>{s.title}</strong>
              </a>
            </li>
          ))}
        </ol>
        <div style="margin-top: var(--sp-6)">
          <Button href="/data-engineering/roadmap/" variant="secondary">
            See the full roadmap
          </Button>
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="int-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Interview</p>
        <h2 id="int-h">Three focused ways to prepare</h2>
      </div>
      <ul class="tile-grid" role="list">
        <li>
          <Tile
            href="/interview/"
            eyebrow="Technology interviews"
            title="Interview questions"
            description="Direct answers first, then reasoning, common mistakes and follow-ups."
            meta={[plural(questions.length, "question")]}
          />
        </li>
        <li>
          <Tile
            href="/data-engineering/system-design/"
            eyebrow="System design"
            title="Case studies"
            description="Requirements, architecture, reliability and trade-offs for real data platforms."
            meta={[`${designs.length} case studies`]}
          />
        </li>
        <li>
          <Tile
            href="/interview/companies/"
            eyebrow="Company preparation"
            title="Company guides"
            description="Preparation that separates attributed information from practice questions."
            meta={[`${companies.length} companies`]}
          />
        </li>
      </ul>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="section" aria-labelledby="proj-h">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Projects</p>
          <h2 id="proj-h">Build something you can explain</h2>
        </div>
        <ul class="tile-grid tile-grid--wide" role="list">
          {featuredProjects.map((p) => (
            <li>
              <Tile
                href={p.url}
                level={p.entry.data.level}
                title={p.title}
                description={p.entry.data.problemStatement}
                meta={[p.entry.data.technologies.slice(0, 3).join(" · ")]}
              />
            </li>
          ))}
        </ul>
        <div style="margin-top: var(--sp-6)">
          <Button href="/projects/" variant="secondary">
            All {projects.length} projects
          </Button>
        </div>
      </div>
    </section>
  )}

  {featured.length > 0 && (
    <section class="section" aria-labelledby="feat-h">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Featured guides</p>
          <h2 id="feat-h">Start with these</h2>
        </div>
        <ul class="tile-grid tile-grid--wide" role="list">
          {featured.map((a) => (
            <li>
              <Tile
                href={a.url}
                eyebrow={a.typeLabel}
                title={a.title}
                description={a.description}
                level={a.difficulty}
                meta={[`${a.minutes} min read`]}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="trust-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How we write</p>
        <h2 id="trust-h">Editorial principles</h2>
      </div>
      <ul class="principles">
        <li>
          <h3>Reviewed technical content</h3>
          <p>
            Claims about tools are checked against official documentation, and each page shows when
            it was last reviewed.
          </p>
        </li>
        <li>
          <h3>Version-aware</h3>
          <p>
            Where behaviour depends on a version or platform release, the page says which one it
            describes.
          </p>
        </li>
        <li>
          <h3>Evidence-labelled interviews</h3>
          <p>
            Company material is labelled as attributed, reported or representative practice. We
            never present invented questions as real ones.
          </p>
        </li>
        <li>
          <h3>Structured paths</h3>
          <p>Every lesson sits in a course with a clear previous and next step.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
